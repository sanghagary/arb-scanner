{
  "name": "arb-scanner",
  "version": "1.0.0",
  "description": "Polymarket / Kalshi cross-market arbitrage scanner",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build": "pkg server.js --target node18-win-x64 --output dist/arb-scanner.exe --compress GZip",
    "build:all": "pkg server.js --targets node18-win-x64,node18-macos-x64,node18-linux-x64 --output dist/arb-scanner --compress GZip"
  },
  "pkg": {
    "assets": ["scanner.html"],
    "targets": ["node18-win-x64"]
  },
  "dependencies": {
    "axios": "^1.6.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "node-cache": "^5.1.2"
  },
  "devDependencies": {
    "pkg": "^5.8.1"
  }
}
